  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Google SRE 4 Golden Signals Overview",
      "type": "row"
    },
    {
      "id": 2,
      "title": "1. Traffic (Throughput: Requests / Second)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (service)",
          "legendFormat": "{{service}} QPS",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "2. Errors (HTTP 5xx Rate vs 2xx Success Rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[1m])) / sum(rate(http_request_duration_seconds_count[1m])) * 100",
          "legendFormat": "5xx Error %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "3. Latency (p50, p95, p99 Duration)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency (s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency (s)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "4. Saturation (Node.js Memory & Event Loop)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "{{service}} RSS Memory (MB)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
